# Copy this to .env and fill in real values. Never commit .env itself.

# --- Database ---
DATABASE_URL=postgres://user:password@host:5432/sbc_growth_engine

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
SESSION_SECRET=replace_with_a_long_random_string

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS (which frontend origins may call this API) ---
ALLOWED_ORIGINS=http://localhost:5173,https://www.sbclabs.tech

# --- Public API rate limiting (requests per window, per IP) ---
PUBLIC_RATE_LIMIT_MAX=20
PUBLIC_RATE_LIMIT_WINDOW_MINUTES=15

# --- Email (Phase 4 — leave blank until wired up) ---
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=letsbuild79@gmail.com

# --- WhatsApp deep-link number (already used on public site) ---
WHATSAPP_NUMBER=919962453537

# --- New-enquiry WhatsApp alerts to the owner ---
# WHATSAPP_PROVIDER=callmebot        # callmebot | meta | off
# CALLMEBOT_PHONE=91XXXXXXXXXX
# CALLMEBOT_APIKEY=
# APP_BASE_URL=https://<growth-engine-app-domain>
